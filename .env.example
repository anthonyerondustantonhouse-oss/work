# Copy to .env and fill in. The .env file is git-ignored; never commit it.

# --- Bullhorn (REST API, OAuth password grant) ---
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_USERNAME=
BULLHORN_PASSWORD=
# Data-centre specific. Find yours with:
#   https://rest.bullhornstaffing.com/rest-services/loginInfo?username=<BULLHORN_USERNAME>
# and use the oauthUrl / restUrl it returns as the base for the three URLs below.
BULLHORN_AUTH_URL=https://auth.bullhornstaffing.com/oauth/authorize
BULLHORN_REST_TOKEN_URL=https://auth.bullhornstaffing.com/oauth/token
BULLHORN_REST_LOGIN_URL=https://rest.bullhornstaffing.com/rest-services/login

# A throwaway record used ONLY by `mvsync test-note`. Format: Candidate:12345 or ClientContact:12345
BULLHORN_TEST_RECORD=

# --- Metaview ---
METAVIEW_BASE_URL=https://my.metaview.app
# Path appended to the base URL to reach the conversations list ("My conversations").
METAVIEW_CONVERSATIONS_PATH=/notes
# Persistent Chromium profile so the Metaview login survives between runs. Created by `mvsync login`.
PLAYWRIGHT_PROFILE_DIR=./playwright-profile
# Optional JSON file overriding the default DOM selectors (see metaview_bullhorn/selectors.py).
METAVIEW_SELECTORS_FILE=
# How many conversations to look at per run (newest first).
METAVIEW_MAX_CONVERSATIONS=25
PLAYWRIGHT_HEADLESS=true

# --- Identity: attendees matching these are you / colleagues and are never looked up in Bullhorn ---
INTERNAL_EMAIL_DOMAINS=stantonhouse.com
INTERNAL_EMAILS=
# Colleagues as Metaview shows them, comma separated. Needed because the list page shows names, not emails.
INTERNAL_NAMES=Anthony Erondu

# --- Note generation (Claude API). Leave the key blank to draft notes by hand in the confirmation page. ---
ANTHROPIC_API_KEY=
NOTE_MODEL=claude-opus-5
# Bullhorn note action types are configured per firm. Keyword -> action, checked against the conversation title.
NOTE_ACTION_MAP={"interview":"Interview","intake":"Client Call","brief":"Client Call","client":"Client Call","screen":"Candidate Call","catch up":"Candidate Call","catch-up":"Candidate Call","check in":"Candidate Call","offer":"Offer"}
NOTE_DEFAULT_ACTION=Call

# --- Confirmation gate ---
# true: every match waits for approval in the web view (recommended while building trust).
# false: only exact-email matches with exactly one hit are written without a human step.
REQUIRE_CONFIRMATION_FOR_ALL=true
# Approving an item marks it confirmed; the next run writes it. Set true to write immediately on approve.
WRITE_ON_APPROVE=false
CONFIRM_HOST=127.0.0.1
CONFIRM_PORT=8765

# --- Local state and logging ---
DB_PATH=./data/sync.db
LOG_PATH=./data/sync.log
SYNC_INTERVAL_MINUTES=30

# --- Alerts after N consecutive failed runs ---
CONSECUTIVE_FAILURE_ALERT_THRESHOLD=3
ALERT_DESKTOP=true
# Leave the SMTP block blank to disable email alerts.
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
